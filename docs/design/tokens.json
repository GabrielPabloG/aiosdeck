{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "aiosdeck-ocean",
  "description": "Single source of design truth for AiosDeck. Derived from src/aios/ui/theme.py (ocean theme). Until epic D2 lands, theme.py remains the runtime source and this file is its canonical mirror; D2 inverts the dependency (tokens.json -> theme.py, validated by tests).",
  "meta": {
    "version": "0.1.0",
    "source": "src/aios/ui/theme.py",
    "status": "mirror-of-code"
  },
  "color": {
    "background": { "value": "#0b1420" },
    "foreground": { "value": "#d7e6f2" },
    "base": {
      "abyss": { "value": "#0b1420", "comment": "deepest background; Abyss layer (long-term memory)" },
      "deep": { "value": "#10293c", "comment": "panel background" },
      "surf": { "value": "#123a52", "comment": "raised surface, selected row" },
      "foam": { "value": "#1d5463", "comment": "muted fill, secondary chrome" },
      "sky": { "value": "#2a718e", "comment": "mid accent, agent idle" },
      "ice": { "value": "#9cc3d8", "comment": "secondary text, labels" }
    },
    "accent": {
      "info": { "value": "#38bdf8", "comment": "cyan; focus, running, sonar sweep" },
      "success": { "value": "#2dd4bf", "comment": "teal; completed, healthy" },
      "warning": { "value": "#fbbf24", "comment": "amber; blocked, degraded" },
      "danger": { "value": "#f87171", "comment": "red; failed, timeout, cancelled" }
    },
    "border": {
      "subtle": { "value": "#14283f" },
      "default": { "value": "#1e3a5f" },
      "focused": { "value": "#38bdf8" }
    }
  },
  "typography": {
    "fontData": { "value": "JetBrains Mono, Fira Code, monospace", "comment": "all metrics, logs, IDs, code" },
    "fontContent": { "value": "Inter, system-ui, sans-serif", "comment": "prose, descriptions" },
    "size": {
      "display": { "value": "24" },
      "title": { "value": "16" },
      "body": { "value": "13" },
      "meta": { "value": "11" }
    }
  },
  "spacing": {
    "unit": { "value": "8" },
    "panelPadding": { "value": "16" },
    "gap": { "value": "8" }
  },
  "shape": {
    "radius": { "value": "2", "comment": "near-sharp; instrument feel" },
    "strokeThin": { "value": "1" },
    "strokeFocus": { "value": "2" }
  },
  "status": {
    "running": { "value": "{color.accent.info.value}" },
    "completed": { "value": "{color.accent.success.value}" },
    "blocked": { "value": "{color.accent.warning.value}" },
    "failed": { "value": "{color.accent.danger.value}" },
    "idle": { "value": "{color.base.sky.value}" }
  }
}
